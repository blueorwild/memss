# 复制为 .env 后按需修改（.env 已被 git 忽略）

# SQLite 数据库文件路径
DATABASE_URL="./data/app.db"

# 主密钥：用于加密存储 AI Provider 的 API Key（生产环境务必设置，且设置后不要更换，否则旧密文无法解密）
# 留空时本地回退到自动生成的 data/secret.key
AGENT_SECRET=""

# 媒体文件根目录（含 seed 与 uploads）；容器部署时通常挂载到 /media
# 说明：Phase 3 部署改造后生效
MEDIA_ROOT="./media"

# 访问保护（应用内密码登录）；Phase 3 部署改造后生效
ACCESS_PASSWORD=""
AUTH_SECRET=""
